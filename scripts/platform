#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

source "${SCRIPT_DIR}/lib/bootstrap.sh"

COMMAND="${1:-help}"

case "${COMMAND}" in

    version)
        platform_version
        ;;

    help)
        platform_help
        ;;

    *)
        error "Unknown command: ${COMMAND}"
        echo
        platform_help
        exit 1
        ;;

esac
