#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

source "${SCRIPT_DIR}/lib/bootstrap.sh"

COMMAND="${1:-help}"
ARG="${2:-all}"

case "${COMMAND}" in

    version)
        platform_version
        ;;

    help)
        platform_help
        ;;
    start)
        platform_start "$ARG"
	;;
    stop)
       platform_stop "$ARG"
       ;;
    setup)
       platform_setup
       ;;
    wake)
       platform_wake
       ;;
    sleep)
       platform_sleep
       ;;

    *)
        error "Unknown command: ${COMMAND}"
        echo
        platform_help
        exit 1
        ;;

esac
