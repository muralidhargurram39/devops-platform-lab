#!/usr/bin/env bash

###############################################################################
# DevOps Lab Platform CLI
#
# Main entry point for the DevOps Lab Platform.
#
# Responsibilities:
#   - Load shared libraries
#   - Parse command-line arguments
#   - Dispatch commands
#   - Display help
#
# This file MUST NOT contain platform business logic.
###############################################################################

set -Eeuo pipefail

###############################################################################
# Resolve Runtime Environment
###############################################################################

SCRIPT_DIR="$(
    cd "$(dirname "${BASH_SOURCE[0]}")" &&
    pwd
)"

source "${SCRIPT_DIR}/lib/bootstrap.sh"


###############################################################################
# Display Help
###############################################################################

show_help() {

cat << EOF

${CLI_NAME} v${CLI_VERSION}

Usage:
    platform <command>

Core Commands
    start       Start platform
    stop        Stop platform
    restart     Restart platform
    status      Show platform status
    health      Perform health checks

General
    help        Show this help

EOF

}

###############################################################################
# Dispatcher
###############################################################################

COMMAND="${1:-help}"

case "$COMMAND" in

    start)
        start_platform
        ;;

    stop)
        stop_platform
        ;;

    restart)
        restart_platform
        ;;

    status)
        status_platform
        ;;

    health)
        health_platform
        ;;
    
    doctor)
       command_doctor
       ;;

    help|-h|--help)
        show_help
        ;;

    *)
        print_error "Unknown command: $COMMAND"
        echo
        show_help
        exit 1
        ;;

esac
