#!/usr/bin/env bash

###############################################################################
# DevOps Lab Platform CLI
#
# Main entry point for the DevOps Lab Platform.
#
# Responsibilities:
#   - Load shared libraries
#   - Parse command-line arguments
#   - Dispatch commands
#   - Display help
#
# This file MUST NOT contain platform business logic.
###############################################################################

set -Eeuo pipefail

###############################################################################
# Resolve Runtime Environment
###############################################################################

SCRIPT_DIR="$(
    cd "$(dirname "${BASH_SOURCE[0]}")" &&
    pwd
)"

source "${SCRIPT_DIR}/lib/bootstrap.sh"

###############################################################################
# Display Help
###############################################################################

show_help() {

cat <<EOF

${CLI_NAME} v${CLI_VERSION}

Usage:
    platform <command> [options]

Core Commands
    start       Start platform
    stop        Stop platform
    restart     Restart platform
    status      Show platform status

Operations
    health      Perform health checks
    doctor      Diagnose platform issues
    logs        View platform logs
    metrics     View platform resource metrics
    urls        Display service URLs

General
    help        Show this help

Examples

    platform health
    platform doctor
    platform logs
    platform logs jenkins
    platform logs --tail 100
    platform metrics
    platform metrics jenkins
    platform urls

EOF

}

###############################################################################
# Dispatcher
###############################################################################

COMMAND="${1:-help}"

shift || true

case "$COMMAND" in

    start)

        start_platform
        ;;

    stop)

        stop_platform
        ;;

    restart)

        restart_platform
        ;;

    status)

        status_platform
        ;;

    health)

        health_platform "$@"
        ;;

    doctor)

        command_doctor "$@"
        ;;

    urls)

        command_urls "$@"
        ;;

    logs)

        command_logs "$@"
        ;;

    metrics)

        command_metrics "$@"
        ;;

    help|-h|--help)

        show_help
        ;;

    *)

        log_error "Unknown command: $COMMAND"

        echo

        show_help

        exit 1
        ;;

esac
