#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

source "${SCRIPT_DIR}/lib/bootstrap.sh"

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    start)     platform_start "$@" ;;
    stop)      platform_stop "$@" ;;
    restart)   platform_restart "$@" ;;
    status)    platform_status "$@" ;;
    health)    platform_health "$@" ;;
    logs)      platform_logs "$@" ;;
    shell)     platform_shell "$@" ;;
    exec)      platform_exec "$@" ;;
    doctor)    platform_doctor "$@" ;;
    backup)    platform_backup "$@" ;;
    restore)   platform_restore "$@" ;;
    cleanup)   platform_cleanup "$@" ;;
    config)    platform_config "$@" ;;
    setup)     platform_setup "$@" ;;
    deploy)    platform_deploy "$@" ;;
    wake)      platform_wake "$@" ;;
    sleep)     platform_sleep "$@" ;;
    version)   platform_version "$@" ;;
    help)      platform_help "$@" ;;
    *)
        error "Unknown command: ${COMMAND}"
        echo
        platform_help
        exit 1
        ;;
esac
